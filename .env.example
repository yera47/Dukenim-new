NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=https://dukenim.kz
CRON_SECRET=replace-with-a-random-string-at-least-32-characters
# Azure AI Studio / Foundry — server-only values. Do not expose these with NEXT_PUBLIC_.
# OpenAI-compatible v1 endpoint. The server client appends /chat/completions.
AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_AI_FOUNDRY_API_KEY=your-server-side-key
AZURE_AI_FOUNDRY_DEPLOYMENT=Kimi-K2.6
AZURE_AI_MAX_TENANT_DAILY_REQUESTS=5
AZURE_AI_MAX_PLATFORM_DAILY_REQUESTS=250
# Optional separate image deployment for the AI Studio banner intent (promotional banners only —
# never product/apparel photography). Leave blank and the banner intent fails closed honestly.
AZURE_AI_FOUNDRY_IMAGE_DEPLOYMENT=
# AI Studio is constrained to storefront-copy drafts. Keep these server-only.
# Optional cinematic layer exported from Higgsfield. When blank, Dukenim renders its built-in accessible fallback.
NEXT_PUBLIC_HIGGSFIELD_HERO_VIDEO=
# Polar subscription checkout — do not set partial values in production.
# Checkout, the customer portal and the webhook route render an honest "unavailable" state
# (no fake success) until all values below are present. Point the Polar organization's
# webhook to https://dukenim.kz/api/webhooks/polar once POLAR_WEBHOOK_SECRET is set.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=production
POLAR_BASIC_MONTHLY_PRODUCT_ID=
POLAR_BASIC_ANNUAL_PRODUCT_ID=
POLAR_STANDARD_MONTHLY_PRODUCT_ID=
POLAR_STANDARD_ANNUAL_PRODUCT_ID=
# Small one-time top-up: a fixed number of AI Studio credits (see AI_CREDIT_TOPUP_GRANT below)
# for a single Polar one-time-purchase product. Leave blank and the top-up button stays hidden.
POLAR_AI_CREDIT_TOPUP_PRODUCT_ID=
# Draft default, not a priced commitment — confirm the real amount/price before launch.
AI_CREDIT_TOPUP_GRANT=50
# OAuth UI stays hidden (no dead buttons) until the matching provider is enabled here AND
# configured with real redirect credentials in Supabase Auth.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
NEXT_PUBLIC_APPLE_OAUTH_ENABLED=false
