{
  "expo": {
    "name": "Dukenim",
    "slug": "dukenim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-1024.png",
    "scheme": "dukenim",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "kz.dukenim.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo-mark.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "kz.dukenim.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Dukenim использует камеру только для сканирования штрихкода товара.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo-mark.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dukenim использует выбранные вами фото и видео только для товаров и историй вашего магазина."
        }
      ],
      "expo-web-browser",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "kz.dukenim.app.widgets",
          "groupIdentifier": "group.kz.dukenim.app",
          "widgets": [
            {
              "name": "DukenimOrdersWidget",
              "displayName": "Заказы Dukenim",
              "description": "Новые заказы и заказы в работе без данных покупателей.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d65ce93-0cbd-403c-abd1-03f2d6906da4"
      }
    },
    "owner": "yersat47"
  }
}
