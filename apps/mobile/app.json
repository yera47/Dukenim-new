{
  "expo": {
    "name": "Dukenim",
    "slug": "dukenim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../../public/icon-512.png",
    "scheme": "dukenim",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "kz.dukenim.app",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "../../public/icon-512.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "../../public/icon-512.png"
      },
      "package": "kz.dukenim.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Dukenim использует камеру только для сканирования штрихкода товара."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071B17",
          "image": "../../public/icon-512.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
