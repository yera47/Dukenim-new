{
  "expo": {
    "name": "Dukenim",
    "slug": "dukenim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../../public/icon-512.png",
    "scheme": "dukenim",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "kz.dukenim.app",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.applesignin": ["Default"]
      },
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "../../public/icon-512.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "../../public/icon-512.png"
      },
      "package": "kz.dukenim.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Dukenim использует камеру только для сканирования штрихкода товара.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071B17",
          "image": "../../public/icon-512.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d65ce93-0cbd-403c-abd1-03f2d6906da4"
      }
    },
    "owner": "yersat47"
  }
}
